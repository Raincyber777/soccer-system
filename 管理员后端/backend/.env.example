# ---------------------------------------------------------------------------
# 本地开发环境配置（复制为 .env 后按实际环境修改；.env 已被 .gitignore 忽略）
# 说明：Django 启动时由 config/settings.py 内的极简读取器加载，不引入 python-dotenv
# ---------------------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SECRET_KEY=

# MySQL 8.0（InnoDB / utf8mb4）
DB_NAME=football_admin
DB_USER=fa_admin
DB_PASSWORD=fa_2026_pwd
DB_HOST=127.0.0.1
DB_PORT=3306

# 字段加密与检索哈希（留空则自动生成到 instance/field.key、instance/hash.key）
FIELD_ENCRYPTION_KEY=
ID_CARD_HASH_KEY=

# 业务参数
SELECTION_TOP_N=5
MAX_EXPORT_ROWS=10000
APP_VERSION=1.0.0
